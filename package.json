{
	"name": "wrapido",
	"version": "0.1.3",
	"description": "WordPress REST API Doer: a fast CLI for any WordPress site.",
	"author": "Spacedmonkey (https://www.spacedmonkey.com)",
	"license": "MIT",
	"keywords": [
		"wordpress",
		"wp-cli",
		"rest-api",
		"cli",
		"wp-json",
		"ai",
		"agent",
		"llm"
	],
	"homepage": "https://github.com/spacedmonkey/wrapido#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spacedmonkey/wrapido.git"
	},
	"bugs": {
		"url": "https://github.com/spacedmonkey/wrapido/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"dist",
		"AGENTS.md",
		"skills"
	],
	"type": "module",
	"bin": {
		"wrapido": "./dist/cli.js"
	},
	"dependencies": {
		"@wordpress/url": "^4.56.0",
		"cli-progress": "^3.12.0",
		"commander": "^15.0.0",
		"conf": "^15.1.0",
		"flat": "^6.0.1",
		"json-2-csv": "^5.5.9",
		"ora": "^9.4.1",
		"picocolors": "^1.1.1",
		"table": "^6.9.0",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@types/cli-progress": "^3.11.6",
		"@types/node": "^26.6.4",
		"@wordpress/eslint-plugin": "^27.0.0",
		"@wordpress/prettier-config": "^4.56.0",
		"@wordpress/scripts": "^36.0.0",
		"c8": "^12.0.0",
		"eslint-plugin-import": "^2.32.0",
		"execa": "^9.5.2",
		"istanbul-badges-readme": "^1.9.0",
		"prettier": "npm:wp-prettier@^3.0.3",
		"tsup": "^8.3.5",
		"tsx": "^4.23.15",
		"typescript": "^5.7.2",
		"vitest": "^5.0.3"
	},
	"scripts": {
		"wrapido": "tsx src/bin.ts",
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "npm run test:unit && npm run test:integration",
		"test:unit": "wp-scripts test-unit-js --project unit",
		"test:unit:watch": "wp-scripts test-unit-js --project unit --watch",
		"pretest:integration": "npm run build",
		"test:integration": "vitest run --project integration",
		"pretest:integration:watch": "npm run build",
		"test:integration:watch": "vitest --project integration",
		"test:watch": "npm run test:unit:watch",
		"test:unit:coverage": "rm -rf coverage && mkdir -p coverage/tmp && NODE_V8_COVERAGE=coverage/tmp npm run test:unit",
		"pretest:integration:coverage": "WRAPIDO_COVERAGE=true npm run build",
		"test:integration:coverage": "NODE_V8_COVERAGE=coverage/tmp vitest run --project integration",
		"coverage:report": "c8 report --temp-directory coverage/tmp --report-dir coverage --include \"src/**/*.ts\" --exclude-after-remap --reporter=text-summary --reporter=json-summary --reporter=lcov",
		"coverage:badge": "istanbul-badges-readme --coverageDir=coverage",
		"coverage": "npm run test:unit:coverage && npm run test:integration:coverage && npm run coverage:report && npm run coverage:badge",
		"typecheck": "tsc --noEmit",
		"lint": "wp-scripts lint-js",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"format": "wp-scripts format",
		"sync:plugins": "node scripts/sync-agent-plugins.js",
		"check:plugins": "node scripts/sync-agent-plugins.js --check"
	},
	"overrides": {
		"esbuild": "^0.28.1",
		"js-yaml@^3": {
			"argparse": "^2.0.1"
		},
		"katex": "^0.18.2",
		"markdownlint-cli": {
			"js-yaml": "^5.4.1",
			"smol-toml": "^1.8.1"
		},
		"postcss-selector-parser": "^7.1.6",
		"serialize-javascript": "^7.0.5",
		"uuid": "^11.1.1"
	}
}
